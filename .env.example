# =============================================================================
# GEORGIAN LEGAL AI — MODULAR CONFIGURATION (.env)
# =============================================================================

# --- 1. API KEYS & SECURITY ---
GOOGLE_API_KEY=your_google_gemini_api_key_here
ADMIN_PASS=admin123
ENABLE_DEV_RELOAD=1

# --- 2. HARDWARE & MODEL PROFILE (Choose based on your GPU / Hosting) ---
# EMBED_PROVIDER options: "gguf" (Local llama.cpp), "huggingface" (SentenceTransformers), "google" (0GB VRAM API)
EMBED_PROVIDER=gguf
EMBED_MODEL_PATH=Qwen3-Embedding-8B-Q8_0.gguf
EMBED_GPU_LAYERS=-1
EMBED_CTX=2048

# RERANKER_PROVIDER options: "cross_encoder" (GPU/CPU CrossEncoder), "none" (Fast RRF + Header Match only)
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=1024

# ROUTER_PROVIDER options:
#   "hybrid"     -> Cloud Structured Decomposer + Local GGUF Fallback (Best for 16GB VRAM)
#   "cloud_only" -> Does NOT load local Router GGUF into VRAM! Saves ~3GB VRAM (Best for <=8GB VRAM / Cloud)
#   "local_only" -> 100% Local GGUF Router
ROUTER_PROVIDER=hybrid
ROUTER_MODEL_PATH=Qwen_Qwen3.5-4B-Q4_K_M.gguf
ROUTER_N_GPU_LAYERS=-1
ROUTER_N_CTX=2048

# --- 3. GENERATOR LLM CONFIGURATION ---
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GENERATOR_TIMEOUT_SECONDS=45.0
PLANNER_TIMEOUT_SECONDS=12.0

# --- 4. RETRIEVAL & MEMORY TUNING ---
RETRIEVAL_TOP_K=6
MAX_HISTORY_TURNS=6
LEGAL_AGENT_LOG_LEVEL=INFO